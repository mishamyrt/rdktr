{
    "name": "rdktr",
    "version": "0.1.1",
    "description": "Fast stop-word / text-cleanliness checker",
    "repository": {
      "url": "https://github.com/mishamyrt/rdktr"
    },
    "type": "module",
    "main": "src/index.js",
    "types": "src/index.d.ts",
    "exports": {
        ".": {
            "types": "./src/index.d.ts",
            "default": "./src/index.js"
        },
        "./rdktr.wasm": "./dist/rdktr.wasm"
    },
    "files": [
        "src",
        "dist"
    ],
    "scripts": {
        "build": "./scripts/build.sh",
        "test": "node --test"
    },
    "keywords": [
        "text",
        "linter",
        "stop-words",
        "glavred",
        "plain-language",
        "wasm"
    ],
    "license": "MIT"
}
